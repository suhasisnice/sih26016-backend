# Copy this to .env and adjust if needed. .env itself is never committed.

DATABASE_URL=postgresql://sih26016:sih26016@db:5432/sih26016

# CORS - frontend dev origin
FRONTEND_ORIGIN=http://localhost:5173

# Uploaded document storage (inside the container/volume)
UPLOAD_DIR=/app/uploads

# Signs the login tokens. Set a real value before any shared deployment.
# SECRET_KEY=

# How long a login lasts. 12 hours covers a demo day without re-logging in.
# ACCESS_TOKEN_EXPIRE_MINUTES=720

# "development" (default) or "production".
# ENVIRONMENT=development

# SIH demo switch. When true, startup loads the fictional records under
# ../data/demo_synthetic. Keep false for production.
DEMO_SEED_ENABLED=true

# Public-source acquisition switch. When true, startup loads the curated
# records under ../data/real_acquisition_seed into the read-only
# public_acquisition_records table. Keep false for production.
REAL_SEED_ENABLED=true

# SMS/email delivery for POST /notices/subscribe. "mock" (default) logs
# instead of sending — see app/integrations/messaging/. Set to "live" to
# send SMS via Twilio and email via SMTP, and fill in the vars below.
# NOTIFICATION_PROVIDER=mock

# Twilio — only read when NOTIFICATION_PROVIDER=live. Get
# TWILIO_ACCOUNT_SID from the Twilio console, then authenticate with EITHER
# the Auth Token OR an API Key (SID + secret) — an API Key is scoped and
# revocable, so Twilio recommends it over the full-access Auth Token; set
# whichever pair you have, the API Key wins if both are present.
# TWILIO_SMS_FROM is a Twilio phone number with SMS capability, in
# "+1415..." form — not the recipient's number. Sending to an Indian mobile
# number needs that sender registered under TRAI's DLT framework on
# Twilio's side first; an unregistered sender is typically filtered
# silently rather than bounced, which reads as "nothing happened" here.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Web Push (VAPID) — read regardless of NOTIFICATION_PROVIDER; unlike SMS
# and email there's no vendor account behind it to switch mock/live on, so
# it works the moment a keypair exists. config.py ships a real generated
# keypair as the default (DEV_VAPID_PRIVATE_KEY/PUBLIC_KEY) so this needs
# no setup at all for local dev — set your own pair here only for a real
# deployment, the same way SECRET_KEY gets its own value.
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_CLAIMS_EMAIL=admin@bhoomimitra.gov.in

# SMTP email — only read when NOTIFICATION_PROVIDER=live. For Gmail, use
# smtp.gmail.com:587 with an App Password (not your normal password) as
# SMTP_PASSWORD.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_USE_TLS=true
