# Copy this to .env and adjust if needed. .env itself is never committed.

DATABASE_URL=postgresql://sih26016:sih26016@db:5432/sih26016

# CORS - frontend dev origin
FRONTEND_ORIGIN=http://localhost:5173

# Uploaded document storage (inside the container/volume)
UPLOAD_DIR=/app/uploads

# Signs the login tokens. Set a real value before any shared deployment.
# SECRET_KEY=

# How long a login lasts. 12 hours covers a demo day without re-logging in.
# ACCESS_TOKEN_EXPIRE_MINUTES=720

# "development" (default) or "production".
# ENVIRONMENT=development

# SIH demo switch. When true, startup loads the fictional records under
# ../data/demo_synthetic. Keep false for production.
DEMO_SEED_ENABLED=true

# Public-source acquisition switch. When true, startup loads the curated
# records under ../data/real_acquisition_seed into the read-only
# public_acquisition_records table. Keep false for production.
REAL_SEED_ENABLED=true

# WhatsApp/email delivery for POST /notices/subscribe. "mock" (default) logs
# instead of sending — see app/integrations/messaging/. Set to "live" to
# send WhatsApp via Twilio and email via SMTP, and fill in the vars below.
# NOTIFICATION_PROVIDER=mock

# Twilio WhatsApp — only read when NOTIFICATION_PROVIDER=live. Get the
# Account SID/Auth Token from the Twilio console; while testing, join the
# WhatsApp sandbox and use its number (already in "whatsapp:+1415..." form)
# for TWILIO_WHATSAPP_FROM.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# SMTP email — only read when NOTIFICATION_PROVIDER=live. For Gmail, use
# smtp.gmail.com:587 with an App Password (not your normal password) as
# SMTP_PASSWORD.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_USE_TLS=true
