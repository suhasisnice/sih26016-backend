# Copy this to .env and adjust if needed. .env itself is never committed.

DATABASE_URL=postgresql://sih26016:sih26016@db:5432/sih26016

# CORS - frontend dev origin
FRONTEND_ORIGIN=http://localhost:5173

# Uploaded document storage (inside the container/volume)
UPLOAD_DIR=/app/uploads

# Signs the login tokens. The code ships a dev default so a fresh clone
# runs, which is safe only because this stack is loopback-only with
# synthetic data. Set a real value here before the API is reachable by
# anyone else: whoever holds this can mint a token for any role, admin
# included. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# How long a login lasts. 12 hours covers a demo day without re-logging in.
# ACCESS_TOKEN_EXPIRE_MINUTES=720

# "development" (default) or "production". Production arms the boot guard
# in app/config.py, which refuses to start with the dev SECRET_KEY, a
# wildcard CORS origin, or the compose database host. Leave this alone
# locally; Render sets it. See DEPLOYMENT.md.
# ENVIRONMENT=development
